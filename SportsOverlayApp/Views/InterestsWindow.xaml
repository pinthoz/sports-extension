<Window x:Class="SportsOverlayApp.Views.InterestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What I've learned" Height="720" Width="560" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One learned team/player or competition: name, weight bar, actions. -->
            <DataTemplate x:Key="ProfileRow">
                <Border Style="{StaticResource ListRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SportIcon}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyText}"
                                   ToolTip="{Binding Name}"/>
                        <ProgressBar Grid.Column="2" Style="{StaticResource FluentProgress}" Maximum="1"
                                     Value="{Binding BarValue, Mode=OneWay}" Foreground="{Binding BarBrush}"
                                     Margin="12,0,0,0" ToolTip="{Binding BarTip}"/>
                        <TextBlock Grid.Column="3" Text="{Binding WeightText}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource IconButton}" Content="&#xE7C1;"
                                    Foreground="{Binding FollowBrush}" Click="Follow_Click"
                                    Visibility="{Binding FollowVisibility}" ToolTip="{Binding FollowTip}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                    Click="Forget_Click" ToolTip="Forget what was learned about this"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,16,24,24">
            <TextBlock Text="What I've learned" Style="{StaticResource TitleText}"/>

            <!-- Status, InfoBar-style -->
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusIcon" Style="{StaticResource IconText}" Text="&#xE946;"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatusTitle" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   TextTrimming="None" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Following -->
            <TextBlock Text="Following" Style="{StaticResource SubtitleText}"/>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"
                               Text="Games of these teams and players always show on the bar and in This week, starred or not."/>
                    <ItemsControl x:Name="FollowList" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="16" Background="{StaticResource ControlFill}"
                                        BorderBrush="{StaticResource ControlStroke}" BorderThickness="1"
                                        Padding="12,0,2,0" Margin="0,0,8,8" Height="32">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SportIcon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                                Width="26" Height="26" Margin="4,0,0,0"
                                                Click="Unfollow_Click" ToolTip="Unfollow"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoFollows" Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                               Foreground="{StaticResource TextTertiary}"
                               Text="You're not following anyone yet. Use the flag next to a team below, or add one here."/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FollowInput" Style="{StaticResource FluentTextBox}"
                                 Tag="Team or player, as FlashScore writes it (e.g. Benfica, Borges N.)"
                                 KeyDown="FollowInput_KeyDown"/>
                        <Button Grid.Column="1" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                Click="FollowAdd_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="#E4000000" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Follow" Foreground="#E4000000" FontSize="14"
                                           FontFamily="{StaticResource TextFont}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <WrapPanel x:Name="SportPicker" Margin="0,10,0,0">
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="Sport" Tag="football" Content="⚽  Football" IsChecked="True"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="Sport" Tag="tennis" Content="🎾  Tennis"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="Sport" Tag="basketball" Content="🏀  Basketball"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="Sport" Tag="hockey" Content="🏒  Hockey"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="Sport" Tag="volleyball" Content="🏐  Volleyball"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Learned teams and players -->
            <TextBlock Text="Teams and players" Style="{StaticResource SubtitleText}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl x:Name="TeamList" ItemTemplate="{StaticResource ProfileRow}"/>
                    <TextBlock x:Name="NoTeams" Style="{StaticResource CaptionText}" Margin="12,10"
                               Text="Nothing learned yet. Star games on FlashScore and they'll show up here."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Competitions" Style="{StaticResource SubtitleText}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl x:Name="CompetitionList" ItemTemplate="{StaticResource ProfileRow}"/>
                    <TextBlock x:Name="NoCompetitions" Style="{StaticResource CaptionText}" Margin="12,10"
                               Text="No competitions yet."/>
                </StackPanel>
            </Border>

            <!-- Dislikes -->
            <TextBlock Text="Not interested" Style="{StaticResource SubtitleText}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl x:Name="DislikeList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SportIcon}" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                   Foreground="{StaticResource TextSecondary}" ToolTip="{Binding Name}"/>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE7A7;"
                                                Click="Forget_Click" ToolTip="Undo: allow this matchup to be recommended again"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoDislikes" Style="{StaticResource CaptionText}" Margin="12,10"
                               Text="Recommendations you close with ✕ are listed here."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>

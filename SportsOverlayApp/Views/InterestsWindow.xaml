<Window x:Class="SportsOverlayApp.Views.InterestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sports Overlay: What I've learned" Height="620" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E26">
    <Window.Resources>
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{Binding Label}"/>
                <Border Grid.Column="1" Height="6" Background="#33FFFFFF" CornerRadius="3"
                        VerticalAlignment="Center" Visibility="{Binding BarVisibility}">
                    <Border Width="{Binding BarWidth}" HorizontalAlignment="Left"
                            Background="{Binding BarBrush}" CornerRadius="3"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding WeightText}" Foreground="#AAFFFFFF"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Content="{Binding ActionText}" Margin="8,0,0,0" Padding="6,0"
                        Click="Forget_Click" ToolTip="{Binding ActionTip}"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Foreground="#CCFFFFFF" TextWrapping="Wrap"/>
        <Button DockPanel.Dock="Bottom" Content="Close" Width="80" HorizontalAlignment="Right"
                Margin="0,12,0,0" Click="Close_Click"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Teams and players" Style="{StaticResource Heading}"/>
                <ItemsControl x:Name="TeamList" ItemTemplate="{StaticResource RowTemplate}"/>
                <TextBlock Text="Competitions" Style="{StaticResource Heading}"/>
                <ItemsControl x:Name="CompetitionList" ItemTemplate="{StaticResource RowTemplate}"/>
                <TextBlock Text="Not interested (✕)" Style="{StaticResource Heading}"/>
                <ItemsControl x:Name="DislikeList" ItemTemplate="{StaticResource RowTemplate}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="SportsOverlayApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="760" Width="620" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="RowIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Margin" Value="0,0,16,0"/>
            </Style>
            <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}"/>
            <Style x:Key="RowDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextTrimming" Value="None"/>
                <Setter Property="Margin" Value="0,2,16,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#0AFFFFFF" BorderBrush="{StaticResource Divider}"
                BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Style="{StaticResource AccentButton}" MinWidth="110" Margin="0,0,8,0"
                        Click="Save_Click" IsDefault="True"/>
                <Button Content="Cancel" Style="{StaticResource FluentButton}" MinWidth="110"
                        Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,24">
                <TextBlock Text="Settings" Style="{StaticResource TitleText}"/>

                <!-- Games -->
                <TextBlock Text="Games" Style="{StaticResource SubtitleText}"/>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE774;" Style="{StaticResource RowIcon}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Data source" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Where the bar reads your games from" Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <ComboBox x:Name="SourceSelector" Grid.Column="2" Style="{StaticResource FluentComboBox}"
                                  VerticalAlignment="Center" MinWidth="220">
                            <ComboBoxItem Content="Built-in FlashScore"/>
                            <ComboBoxItem Content="Browser extension"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE734;" Style="{StaticResource RowIcon}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Recommendations" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Suggest games like the ones you star, and always show teams you follow"
                                       Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <CheckBox x:Name="RecommendationsToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                    </Grid>
                </Border>

                <!-- Bar -->
                <TextBlock Text="Bar" Style="{StaticResource SubtitleText}"/>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE90C;" Style="{StaticResource RowIcon}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Position" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="On the taskbar, you can drag the pills to place them" Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <ComboBox x:Name="PositionSelector" Grid.Column="2" Style="{StaticResource FluentComboBox}"
                                  VerticalAlignment="Center" MinWidth="220">
                            <ComboBoxItem Content="Above the taskbar"/>
                            <ComboBoxItem Content="Top of the screen"/>
                            <ComboBoxItem Content="On the taskbar"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xEF1F;" Style="{StaticResource RowIcon}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Opacity" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="How see-through the bar is" Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="OpacityValue" Style="{StaticResource CaptionText}" Width="40"
                                       TextAlignment="Right" Margin="0,0,12,0"/>
                            <Slider x:Name="OpacitySlider" Style="{StaticResource FluentSlider}" Width="180"
                                    Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE793;" Style="{StaticResource RowIcon}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Dark theme" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Dark pills on the bar (off for light)" Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <CheckBox x:Name="DarkModeToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE945;" Style="{StaticResource RowIcon}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Highlight goals" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="The game turns green for about 90 seconds, no sound" Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <CheckBox x:Name="NotificationsToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE740;" Style="{StaticResource RowIcon}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Hide in fullscreen" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Get out of the way of videos and games; shows briefly when one of your games has a goal"
                                       Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <CheckBox x:Name="FullscreenToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                    </Grid>
                </Border>

                <!-- System -->
                <TextBlock Text="System" Style="{StaticResource SubtitleText}"/>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7B5;" Style="{StaticResource RowIcon}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Open the bar automatically when you sign in" Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <CheckBox x:Name="StartupToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE968;" Style="{StaticResource RowIcon}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Extension port" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Only for the browser extension; must match the port in its popup"
                                       Style="{StaticResource RowDescription}"/>
                        </StackPanel>
                        <TextBox x:Name="PortInput" Grid.Column="2" Style="{StaticResource FluentTextBox}"
                                 Width="100" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

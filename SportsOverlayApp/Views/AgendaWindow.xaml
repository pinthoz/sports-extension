<Window x:Class="SportsOverlayApp.Views.AgendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="This week" Height="740" Width="600" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Crest or flag next to a name; hidden when the game has none. -->
            <Style x:Key="Crest" TargetType="Image">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Style.Triggers>
                    <Trigger Property="Source" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="This week" Style="{StaticResource TitleText}"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" TextTrimming="None"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource FluentButton}" VerticalAlignment="Top"
                            Margin="12,6,0,0" Click="Refresh_Click" ToolTip="Refresh">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Refresh" FontFamily="{StaticResource TextFont}" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Legend -->
                <WrapPanel Margin="0,12,0,0" x:Name="Legend">
                    <Border Style="{StaticResource Tag}" Margin="0,0,8,0" Background="#2E6CCB5F">
                        <TextBlock Text="Following" FontSize="12" Foreground="{StaticResource SuccessFill}"/>
                    </Border>
                    <Border Style="{StaticResource Tag}" Margin="0,0,8,0" Background="#2EFFD54F">
                        <TextBlock Text="Starred" FontSize="12" Foreground="{StaticResource StarFill}"/>
                    </Border>
                    <Border Style="{StaticResource Tag}" Margin="0,0,8,0">
                        <TextBlock Text="For you" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </WrapPanel>

                <ItemsControl x:Name="DayList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4,24,0,8">
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="8,1,0,0"/>
                                </StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <ItemsControl ItemsSource="{Binding Games}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ListRow}" Cursor="Hand"
                                                        MouseLeftButtonUp="Row_Click" ToolTip="Open match details">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="56"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource DisplayFont}"
                                                                   FontSize="16" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Source="{Binding HomeLogo}" Style="{StaticResource Crest}"/>
                                                                <Image Source="{Binding HomeLogo2}" Style="{StaticResource Crest}"/>
                                                                <TextBlock Text="{Binding Home}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="vs" Style="{StaticResource CaptionText}" Margin="8,0"
                                                                           Foreground="{StaticResource TextTertiary}"/>
                                                                <Image Source="{Binding AwayLogo}" Style="{StaticResource Crest}"/>
                                                                <Image Source="{Binding AwayLogo2}" Style="{StaticResource Crest}"/>
                                                                <TextBlock Text="{Binding Away}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding SportIcon}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding Competition}" Style="{StaticResource CaptionText}"
                                                                           MaxWidth="260" ToolTip="{Binding Competition}"/>
                                                                <Border Style="{StaticResource Tag}" Background="{Binding TagFill}">
                                                                    <TextBlock Text="{Binding TagText}" FontSize="11" Foreground="{Binding TagBrush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE787;"
                                                                    Click="Ics_Click" ToolTip="Add to your calendar app (Outlook, Calendar)"/>
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE774;"
                                                                    Click="Google_Click" ToolTip="Add to Google Calendar"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="340" Margin="24,120,24,0" Visibility="Collapsed">
            <TextBlock Text="&#xE787;" Style="{StaticResource IconText}" FontSize="40"
                       Foreground="{StaticResource TextTertiary}"/>
            <TextBlock Text="Filling in your week" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,4"/>
            <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None"
                       Text="The app scans the week's games in the background; they appear here within a few minutes. Follow teams in What I've learned to always see their games."/>
        </StackPanel>
    </Grid>
</Window>
